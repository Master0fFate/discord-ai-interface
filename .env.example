# Copy to .env only if your process manager loads it. This application does not
# implicitly read .env files. Never commit the populated file.
DISCORD_BOT_TOKEN=
# Optional path to the non-secret JSON configuration file:
DISCORD_AI_CONFIG=./discord-ai.config.json
# Required for mutation commands and MCP; contains no secrets:
DISCORD_AI_POLICY=./discord-ai.policy.json
# Durable operations, confirmations, plans, and append-only audit evidence:
DISCORD_AI_DATA_DIR=./.discord-ai-interface
